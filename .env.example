# Public browser configuration only. Leave blank to keep cloud features disabled.
# Copy to .env.local for local development and replace with the approved project's
# URL (https://<project-ref>.supabase.co) and publishable key (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional legacy compatibility: use an anon-role JWT only when a publishable
# key is unavailable. A nonempty publishable key takes precedence.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Next.js checks both public key variables before bundling, even an unused
# fallback. Use only publishable or anon keys; this check does not verify them.
# These values are exposed in the browser bundle. Never put privileged API keys,
# database passwords, Google OAuth client secrets, access tokens, or share tokens
# here. Google credentials belong in the authorized secure provider setup.
